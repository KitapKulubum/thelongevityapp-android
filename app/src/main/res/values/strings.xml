    <!-- Onboarding questions (chat flow) -->
    <string name="onboarding_sleep_prompt">How would you rate your typical sleep quality and duration?</string>
    <string name="onboarding_sleep_opt_0">Very poor (&lt;5 hours, restless)</string>
    <string name="onboarding_sleep_opt_1">Below average (5-6 hours, interrupted)</string>
    <string name="onboarding_sleep_opt_2">Neutral (6-7 hours, occasional issues)</string>
    <string name="onboarding_sleep_opt_3">Good (7-8 hours, mostly restful)</string>
    <string name="onboarding_sleep_opt_4">Excellent (8+ hours, consistently deep)</string>
    <string name="onboarding_activity_prompt">How active is your daily routine?</string>
    <string name="onboarding_activity_opt_0">Very sedentary (mostly sitting)</string>
    <string name="onboarding_activity_opt_1">Light activity (walking &lt;30 min/day)</string>
    <string name="onboarding_activity_opt_2">Moderate (30-60 min movement/day)</string>
    <string name="onboarding_activity_opt_3">Active (60+ min exercise/week)</string>
    <string name="onboarding_activity_opt_4">Very active (150+ min/week, strength training)</string>
    <string name="onboarding_muscle_prompt">How would you assess your muscle mass and strength?</string>
    <string name="onboarding_muscle_opt_0">Very low (noticeable weakness)</string>
    <string name="onboarding_muscle_opt_1">Below average (struggles with daily tasks)</string>
    <string name="onboarding_muscle_opt_2">Average (maintains basic strength)</string>
    <string name="onboarding_muscle_opt_3">Good (regular strength training)</string>
    <string name="onboarding_muscle_opt_4">Excellent (high muscle mass, strong)</string>
    <string name="onboarding_visceral_fat_prompt">How would you describe your body composition, especially around the midsection?</string>
    <string name="onboarding_visceral_fat_opt_0">High visceral fat (significant belly fat)</string>
    <string name="onboarding_visceral_fat_opt_1">Above average (some excess abdominal fat)</string>
    <string name="onboarding_visceral_fat_opt_2">Average (moderate body fat)</string>
    <string name="onboarding_visceral_fat_opt_3">Good (low body fat, toned)</string>
    <string name="onboarding_visceral_fat_opt_4">Excellent (lean, defined abs)</string>
    <string name="onboarding_nutrition_prompt">How would you rate your overall nutrition pattern?</string>
    <string name="onboarding_nutrition_opt_0">Very poor (mostly processed, fast food)</string>
    <string name="onboarding_nutrition_opt_1">Below average (inconsistent, some processed)</string>
    <string name="onboarding_nutrition_opt_2">Neutral (mixed, some whole foods)</string>
    <string name="onboarding_nutrition_opt_3">Good (mostly whole foods, balanced)</string>
    <string name="onboarding_nutrition_opt_4">Excellent (whole foods, nutrient-dense, planned)</string>
    <string name="onboarding_sugar_prompt">How much added sugar and refined carbs do you consume?</string>
    <string name="onboarding_sugar_opt_0">Very high (daily sweets, sodas, desserts)</string>
    <string name="onboarding_sugar_opt_1">High (several times/week)</string>
    <string name="onboarding_sugar_opt_2">Moderate (occasional treats)</string>
    <string name="onboarding_sugar_opt_3">Low (rarely, mostly natural sources)</string>
    <string name="onboarding_sugar_opt_4">Minimal (almost none, whole foods only)</string>
    <string name="onboarding_stress_prompt">How would you rate your stress levels and management?</string>
    <string name="onboarding_stress_opt_0">Very high (chronic stress, overwhelmed)</string>
    <string name="onboarding_stress_opt_1">High (frequent stress, limited coping)</string>
    <string name="onboarding_stress_opt_2">Moderate (some stress, occasional management)</string>
    <string name="onboarding_stress_opt_3">Low (good coping strategies)</string>
    <string name="onboarding_stress_opt_4">Very low (excellent stress management, calm)</string>
    <string name="onboarding_smoking_alcohol_prompt">Do you smoke or consume alcohol regularly?</string>
    <string name="onboarding_smoking_alcohol_opt_0">Heavy (daily smoking or heavy drinking)</string>
    <string name="onboarding_smoking_alcohol_opt_1">Regular (smoking or drinking several times/week)</string>
    <string name="onboarding_smoking_alcohol_opt_2">Occasional (social drinking, no smoking)</string>
    <string name="onboarding_smoking_alcohol_opt_3">Rare (very occasional, minimal)</string>
    <string name="onboarding_smoking_alcohol_opt_4">None (no smoking, no alcohol)</string>
    <string name="onboarding_metabolic_prompt">How would you assess your metabolic health (energy, blood sugar stability)?</string>
    <string name="onboarding_metabolic_opt_0">Poor (energy crashes, sugar cravings)</string>
    <string name="onboarding_metabolic_opt_1">Below average (occasional crashes)</string>
    <string name="onboarding_metabolic_opt_2">Average (stable most of the time)</string>
    <string name="onboarding_metabolic_opt_3">Good (consistent energy, stable)</string>
    <string name="onboarding_metabolic_opt_4">Excellent (high energy, no crashes)</string>
    <string name="onboarding_energy_focus_prompt">How would you rate your daily energy and mental focus?</string>
    <string name="onboarding_energy_focus_opt_0">Very low (constant fatigue, brain fog)</string>
    <string name="onboarding_energy_focus_opt_1">Low (frequent tiredness, poor focus)</string>
    <string name="onboarding_energy_focus_opt_2">Average (moderate energy, decent focus)</string>
    <string name="onboarding_energy_focus_opt_3">Good (consistent energy, good focus)</string>
    <string name="onboarding_energy_focus_opt_4">Excellent (high energy, sharp focus)</string>
