<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.TheLongevityApp" parent="android:Theme.Material.NoActionBar">
        <item name="android:statusBarColor">@android:color/black</item>
        <item name="android:navigationBarColor">@android:color/black</item>
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:colorPrimary">#1ABC80</item>
    </style>

    <!-- System splash: black bg, invisible icon → then our Compose splash -->
    <style name="Theme.TheLongevityApp.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@android:color/black</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash_transparent</item>
        <item name="postSplashScreenTheme">@style/Theme.TheLongevityApp</item>
    </style>
</resources>
